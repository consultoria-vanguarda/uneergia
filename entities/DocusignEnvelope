{
  "name": "DocusignEnvelope",
  "type": "object",
  "properties": {
    "envelopeId": {
      "type": "string",
      "description": "ID do envelope no DocuSign"
    },
    "entityType": {
      "type": "string",
      "enum": [
        "Contrato",
        "Proposta",
        "Termo",
        "Outro"
      ],
      "default": "Contrato",
      "description": "Tipo de documento enviado"
    },
    "entityId": {
      "type": "string",
      "description": "ID do registro relacionado no sistema"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "sent",
        "delivered",
        "completed",
        "declined",
        "voided"
      ],
      "default": "created",
      "description": "Status atual do envelope"
    },
    "subject": {
      "type": "string",
      "description": "Assunto do envelope"
    },
    "message": {
      "type": "string",
      "description": "Mensagem personalizada"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Lista de signat\u00e1rios (nome, email, role)"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de envio"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de conclus\u00e3o"
    },
    "lastStatusCheckAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima verifica\u00e7\u00e3o de status"
    },
    "errorLast": {
      "type": "string",
      "description": "\u00daltimo erro registrado"
    },
    "signedDocumentUrl": {
      "type": "string",
      "description": "URL do documento assinado"
    }
  },
  "required": [
    "envelopeId",
    "entityType",
    "status"
  ]
}