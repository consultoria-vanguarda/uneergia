    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "fisica",
        "juridica"
      ],
      "default": "fisica"
    },
    "email": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "estado": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "numero_instalacao": {
      "type": "string",
      "description": "N\u00famero da instala\u00e7\u00e3o na distribuidora"
